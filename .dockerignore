# models/ alone is ~668 MB (ONNX files); never include in build context.
models/
artifacts/
tokenizers/

# Claude-specific files
.claude/
.claude_plugin/

# Documentation
docs/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
